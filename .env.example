# PortalVault — example configuration
#
# This file is committed and contains PLACEHOLDERS ONLY.
# Real values belong in .env.local, which is never committed.
#
#   cp .env.example .env.local
#
# Background and rules: docs/SECURITY.md

# ---------------------------------------------------------------------------
# Supabase — public, not a secret (ADR-0017)
# ---------------------------------------------------------------------------
# Both values deliberately end up in the browser bundle. Security rests on
# Supabase Auth and Row Level Security, NOT on keeping them hidden.
# Not in use yet: Supabase is wired up in V1.2.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Supabase — PRIVILEGED
# ---------------------------------------------------------------------------
# The service role key bypasses Row Level Security COMPLETELY.
#
#   * never in client code
#   * never with the NEXT_PUBLIC_ prefix
#   * never stored in Vercel: no deployed code path reads it (docs/DEPLOYMENT.md)
#   * local use only, for the tools under tools/
#
# If it ever lands in a commit: rotate the key in Supabase.
SUPABASE_SERVICE_ROLE_KEY=
