{
  "name": "portalvault",
  "version": "0.1.0",
  "private": true,
  "description": "Web platform for Skylanders collectors: catalog, accounts, personal collection.",
  "scripts": {
    "dev": "next dev",
    "dev:staging": "node tools/dev-staging.mts",
    "snapshot:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/staging-snapshot.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "orderbook:sales-import:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/import-sales.mts",
    "orderbook:dates:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/apply-workbook-dates.mts",
    "orderbook:import:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/import-orderbook.mts",
    "catalog:import:prod": "node --env-file=.env.local tools/import-catalog.mts",
    "catalog:import:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/import-catalog.mts",
    "characters:import:prod": "node --env-file=.env.local tools/import-characters.mts",
    "characters:import:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/import-characters.mts",
    "seed:category-groups:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/seed-category-groups.mts",
    "seed:shop-fixtures:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/seed-shop-fixtures.mts",
    "admin:grant": "node --env-file=.env.local tools/grant-admin.mts",
    "inventory:import-legacy:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/import-legacy-inventory.mts",
    "inventory:import-legacy:prod": "node --env-file=.env.local tools/import-legacy-inventory.mts",
    "images:export:prod": "node --env-file=.env.local tools/export-image-overrides.mts",
    "images:sync:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/sync-image-overrides.mts",
    "perf:report:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/perf-report.mts",
    "perf:report:prod": "node --env-file=.env.local tools/perf-report.mts",
    "verify:rls:prod": "node --env-file=.env.local tools/verify-rls.mts",
    "verify:rls:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-rls.mts",
    "verify:editorial:prod": "node --env-file=.env.local tools/verify-editorial.mts",
    "verify:editorial:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-editorial.mts",
    "verify:inventory:prod": "node --env-file=.env.local tools/verify-inventory.mts",
    "verify:inventory:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-inventory.mts",
    "verify:shop:prod": "node --env-file=.env.local tools/verify-shop.mts",
    "verify:shop:staging": "node --env-file=.env.staging tools/verify-shop.mts",
    "verify:seller:prod": "node --env-file=.env.local tools/verify-seller.mts",
    "verify:seller:staging": "node --env-file=.env.staging tools/verify-seller.mts",
    "verify:commerce:prod": "node --env-file=.env.local tools/verify-commerce.mts",
    "verify:commerce:staging": "node --env-file=.env.staging tools/verify-commerce.mts",
    "verify:payment-smoke:staging": "node --env-file=.env.staging tools/verify-payment-smoke.mts",
    "transfer:preview": "node --env-file=.env.staging tools/transfer-to-production.mts",
    "transfer:apply": "node --env-file=.env.staging tools/transfer-to-production.mts --apply",
    "verify:purchase-items:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-purchase-items.mts",
    "verify:sale-workflow:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-sale-workflow.mts",
    "verify:settled:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-settled.mts",
    "verify:sale-locks:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-sale-locks.mts",
    "cards:build": "node tools/build-card-templates.mts",
    "verify:payment-mode:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-payment-mode.mts",
    "verify:sandbox-e2e:staging": "SKYISLES_REQUIRE_STAGING=1 node --env-file=.env.staging tools/verify-sandbox-e2e.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
